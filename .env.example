# Copia questo file in .env e adatta i valori al tuo ambiente.
# Variabili lette da backend/app/core/config.py (prefisso NATHION_).

NATHION_ENVIRONMENT=development
NATHION_LOG_LEVEL=INFO

# Percorso del DB SQLite (relativo alla working dir del backend)
NATHION_DATABASE_URL=sqlite:///./data/nathion.db

# --- Ollama ---
# Windows/macOS con Docker Desktop: lascia host.docker.internal, Docker
# Desktop lo risolve automaticamente all'host.
# Linux nativo (Docker Engine senza Desktop): sostituisci con l'IP del
# bridge Docker (di solito 172.17.0.1) oppure usa network_mode: host nel
# docker-compose.yml per il servizio backend — vedi README.
NATHION_OLLAMA_BASE_URL=http://host.docker.internal:11434
NATHION_OLLAMA_REQUEST_TIMEOUT_SECONDS=120

NATHION_DEFAULT_LLM_PROVIDER=ollama

# --- CORS ---
# In produzione (docker compose, non "npm run dev") il frontend gira su
# questa origin: aggiorna se cambi la porta esposta.
NATHION_CORS_ALLOW_ORIGINS=["http://localhost:4173","http://localhost:5173"]

# --- Frontend (build-time) ---
# URL con cui il BROWSER raggiunge il backend. In locale, con la porta
# del backend esposta sull'host, localhost va bene sia in dev che con
# docker compose.
VITE_API_BASE_URL=

# Primo avvio di una nuova istanza (non rinomina account esistenti).
NATHION_ADMIN_USERNAME=mattia
NATHION_ADMIN_DISPLAY_NAME=Mattia
NATHION_ADMIN_EMAIL=
NATHION_PERSONAL_MODE=true
NATHION_OAUTH_ORIGIN=http://localhost:4173
NATHION_GOOGLE_CLIENT_ID=
NATHION_GOOGLE_CLIENT_SECRET=
NATHION_GOOGLE_ADMIN_SUBJECT=
NATHION_GITHUB_CLIENT_ID=
NATHION_GITHUB_CLIENT_SECRET=
NATHION_GITHUB_ADMIN_ID=
# Attivare per l'accesso privato HTTPS; android-access.ps1 lo imposta.
NATHION_AUTH_COOKIE_SECURE=false
